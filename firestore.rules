rules_version = '2';

// ПРАВИЛА БАЗЫ CineFlow. Сам файл ни на что не влияет: действуют правила,
// вставленные в консоли Firebase (Firestore Database → Rules → Publish).
// Здесь лежит та же копия, чтобы было видно, что стоит и почему.
//
// Комната — единственная граница между проектами: кто знает код, тот
// работает в проекте. Значит, правила обязаны не давать узнать коды
// (запрос «по всем комнатам сразу») и не пускать в комнаты с кодом,
// который можно угадать.
//
// 1. Доступ только по ТОЧНОМУ адресу artifacts/{комната}/public/data/
//    {коллекция}/{запись}. Сквозного правила {path=**} здесь нет
//    намеренно: без него база отказывает в запросе по всем комнатам
//    разом (collection group) — а с ним любой посетитель сайта мог
//    прочитать все проекты и все ключи облаков.
// 2. Код комнаты не короче 12 знаков: новые коды приложения — 21 знак
//    случайных букв и цифр, их не подобрать.
// 3. Старая общая комната 'cineflow-room-3' закрыта: её код записан
//    в открытом коде приложения. Из неё можно прочитать только метку
//    «проект переехал» — по ней оставшиеся на старом коде узнают, что
//    правят копию, которую никто не видит.
// 4. Коллекции — только те, что заводит приложение. Добавляя новую
//    коллекцию в приложении, впиши её сюда, иначе база её не примет.
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{room}/public/data/{coll}/{doc} {
      allow read, write: if request.auth != null
        && room.size() >= 12
        && room != 'cineflow-room-3'
        && coll in ['scenes', 'storyboard', 'references', 'stickies', 'docs', 'crew',
                    'locations', 'projectFiles', 'lightSchemes', 'gearTypes',
                    'lightGearTypes', 'boards', 'messages', 'canvas', 'settings',
                    'userPins', 'boardEls'];
      allow get: if request.auth != null && coll == 'settings' && doc == 'moved';
    }
  }
}
