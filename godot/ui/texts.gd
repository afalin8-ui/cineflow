## Текст команды: поле cmd (word, top, key, hint); нет такой — пусто.
static func cmd(id: StringName, field: String) -> String:
	var d: Dictionary = CMD.get(id, {})
	return str(d.get(field, ""))


## Подсказка кнопки целиком: слово, буква, что делает (и «сейчас недоступно»).
static func tip(id: StringName, word: String, disabled: bool) -> String:
	var k := cmd(id, "key")
	var head := word if k == "" else "%s · %s" % [word, k]
	return "%s\n%s%s" % [head, cmd(id, "hint"), UNAVAILABLE if disabled else ""]
