; Капелла: бой на орбите — срез в Godot 4.7.2.
; Решения — godot/spec/00-architecture.md, план — godot/spec/plan.md (G0, п. 1).
config_version=5

[application]

config/name="Капелла: бой на орбите"
config/description="Срез «Бой на орбите» игры «Капелла» на Godot"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="disabled"

[physics]

common/physics_interpolation=false

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.012, 0.014, 0.025, 1)
